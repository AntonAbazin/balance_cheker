# Порт веб-интерфейса
PORT=3000

# Etherscan API key (V2, multichain) — покрывает Ethereum и BSC одним ключом.
# Получить бесплатно: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# TronGrid API key — не обязателен, но без него более жёсткие лимиты запросов.
# Получить: https://www.trongrid.io/
TRONGRID_API_KEY=

# Telegram-бот для уведомлений.
# Токен — от @BotFather. chat_id своего чата — например через @userinfobot,
# либо через https://api.telegram.org/bot<TOKEN>/getUpdates после того как напишете боту /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Прокси для запросов к Telegram Bot API (если он недоступен напрямую).
# Не обязателен — если не задан, запросы идут напрямую.
# Форматы: http://user:pass@host:port, https://user:pass@host:port,
#          socks5://user:pass@host:port, socks4://host:port
TELEGRAM_PROXY_URL=

# Как часто проверять балансы, в минутах
CHECK_INTERVAL_MINUTES=5
